# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NIMBUS_RUNTIME_ROLE=all
NIMBUS_LOG_LEVEL=INFO
NIMBUS_LOG_JSON=false
NIMBUS_ENABLE_METRICS=true
NIMBUS_API_KEY=
NIMBUS_CORS_ORIGINS=http://localhost:8501
NIMBUS_MAX_REQUEST_MB=10

# -----------------------------------------------------------------------------
# Storage and local paths
# -----------------------------------------------------------------------------
NIMBUS_DB_BACKEND=mongodb
NIMBUS_DB_PATH=./data/nimbus.db
NIMBUS_DATA_DIR=./data/downloads
# Optional explicit path for the shared local download coordinator SQLite file.
# Default: ${NIMBUS_DATA_DIR}/download_coordinator.db
# NIMBUS_DOWNLOAD_COORDINATOR_DB_PATH=/data/downloads/download_coordinator.db

# Local host run (without compose):
NIMBUS_MONGODB_URI=mongodb://127.0.0.1:27017
# Compose-internal Mongo URI used by api/worker containers:
NIMBUS_MONGODB_URI_INTERNAL=mongodb://mongodb:27017
NIMBUS_MONGODB_DB=nimbuschain_fetch

# -----------------------------------------------------------------------------
# Worker scheduling
# -----------------------------------------------------------------------------
NIMBUS_MAX_JOBS=4
NIMBUS_QUEUE_POLL_SECONDS=1.0
NIMBUS_STALE_JOB_SECONDS=900
NIMBUS_WORKER_HEARTBEAT_SECONDS=5.0
NIMBUS_WORKER_STALE_SECONDS=20

# -----------------------------------------------------------------------------
# Provider limits
# Legacy compatibility knob. If you prefer the new split below, leave this set
# to the default or empty.
# -----------------------------------------------------------------------------
NIMBUS_PROVIDER_LIMITS=copernicus=2,usgs=4

# Job limits = how many jobs per provider can execute at once.
NIMBUS_PROVIDER_JOB_LIMITS=copernicus=2,usgs=4

# Control-plane limits = metadata/search/prepare/order orchestration pressure.
# Example: keep USGS prepare very low because download-request preparation is
# not the same as raw file transfer.
NIMBUS_PROVIDER_CONTROL_PLANE_LIMITS=copernicus=2,usgs=1

# Data-plane limits = actual file transfer pressure.
# Copernicus is account-worker based. USGS starts on one account with an
# adaptive window inside this ceiling.
NIMBUS_PROVIDER_DATA_PLANE_LIMITS=copernicus=32,usgs=6

# -----------------------------------------------------------------------------
# Local machine guardrails for downloads
# -----------------------------------------------------------------------------
# Hard cap across all active downloads on this machine.
NIMBUS_DOWNLOAD_GLOBAL_LIMIT=8
# Minimum free bytes required before launching a new download. 0 disables it.
NIMBUS_DOWNLOAD_MIN_FREE_BYTES=0
# Optional global bandwidth cap in bytes/s across the local download manager.
# Example: 125000000 ~= 1 Gbps. Leave commented for unlimited.
# NIMBUS_DOWNLOAD_GLOBAL_MAX_BPS=125000000

# -----------------------------------------------------------------------------
# Copernicus / Sentinel
# -----------------------------------------------------------------------------
NIMBUS_COPERNICUS_BASE_URL=https://catalogue.dataspace.copernicus.eu
NIMBUS_COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
NIMBUS_COPERNICUS_DOWNLOAD_URL=https://zipper.dataspace.copernicus.eu
NIMBUS_COPERNICUS_USERNAME=
NIMBUS_COPERNICUS_PASSWORD=

# Account pool: keep this only for Copernicus.
# You can point to docs/copernicus_account_pool.example.json
# NIMBUS_COPERNICUS_ACCOUNT_POOL_FILE=docs/copernicus_account_pool.example.json
NIMBUS_COPERNICUS_ACCOUNT_POOL_JSON=

# Per-account active download ceiling for Copernicus account workers.
NIMBUS_COPERNICUS_ACCOUNT_POOL_CONCURRENCY=4

# -----------------------------------------------------------------------------
# USGS / Landsat
# -----------------------------------------------------------------------------
NIMBUS_USGS_SERVICE_URL=https://m2m.cr.usgs.gov/api/api/json/stable/
NIMBUS_USGS_USERNAME=
NIMBUS_USGS_TOKEN=

# -----------------------------------------------------------------------------
# Sen2Like / Landsat normalization
# -----------------------------------------------------------------------------
# Internal HTTP service used by the Landsat -> Sentinel-2-like stage.
NIMBUS_SEN2LIKE_SERVICE_URL=http://nimbus-sen2like:8030
NIMBUS_SEN2LIKE_PORT=8030
NIMBUS_SEN2LIKE_WORK_DIR=/data/downloads/sen2like
NIMBUS_SEN2LIKE_WORKERS=4
NIMBUS_SEN2LIKE_TIMEOUT_SECONDS=3600
NIMBUS_SEN2LIKE_RAW_FALLBACK=false
NIMBUS_SEN2LIKE_NESTED_BAND_PARALLELISM=true
NIMBUS_SEN2LIKE_BAND_WORKERS=4
NIMBUS_SEN2LIKE_SAFE_RETRY=true
NIMBUS_SEN2LIKE_PREPROCESS_TARGET_SHAPE=native
NIMBUS_SEN2LIKE_PREPROCESS_WORKERS=2
NIMBUS_SEN2LIKE_MEM_LIMIT=24g
NIMBUS_SEN2LIKE_SHM_SIZE=8g
NIMBUS_SEN2LIKE_SPARK_DRIVER_MEMORY=1g
NIMBUS_SEN2LIKE_SPARK_EXECUTOR_MEMORY=1g
NIMBUS_SEN2LIKE_SPARK_PYTHON_WORKER_MEMORY=256m
NIMBUS_SEN2LIKE_GRI_AUTO_FETCH=true
NIMBUS_SEN2LIKE_ALLOW_GEO_SKIP=false
NIMBUS_SEN2LIKE_GDAL_CACHEMAX=256
NIMBUS_SEN2LIKE_GDAL_NUM_THREADS=1
NIMBUS_SEN2LIKE_JAVA_TOOL_OPTIONS=-Xmx1536m -XX:MaxRAMPercentage=55
NIMBUS_SEN2LIKE_MALLOC_ARENA_MAX=2
NIMBUS_SEN2LIKE_OMP_NUM_THREADS=1
NIMBUS_SEN2LIKE_OPENBLAS_NUM_THREADS=1
NIMBUS_SEN2LIKE_MKL_NUM_THREADS=1

# -----------------------------------------------------------------------------
# UI and side services
# -----------------------------------------------------------------------------
NIMBUS_SERVICE_URL=http://nimbus-api:8000
# Apple Silicon/MPS mode: start `scripts/run_host_mps_mask.sh --daemon` on the
# host, then containers call that native service through Podman's host alias.
# Leave empty to use the in-compose CPU/CUDA mask container.
NIMBUS_MASK_SERVICE_URL=
NIMBUS_ZARR_SERVICE_URL=
NIMBUS_UI_DATA_DIR=/data/downloads
NIMBUS_UI_PORT=8501
NIMBUS_ZARR_PORT=8010
# Default post-fetch/Post-Sen2Like Zarr raster dimensions. Keep native so cloud
# and water masks run on detailed pixels; set 512x512 only for quick smoke tests.
NIMBUS_ZARR_TARGET_SHAPE=native
# Keep Zarr conversion in the orchestrator. Sen2Like direct Zarr duplicates the
# conversion path and costs extra time during full pipeline runs.
NIMBUS_SEN2LIKE_DIRECT_ZARR=false
NIMBUS_SEN2LIKE_ZARR_DIR=/data/downloads/zarr
NIMBUS_MASK_PORT=8020

# -----------------------------------------------------------------------------
# Mask runtime
# -----------------------------------------------------------------------------
NIMBUS_CLOUDMASK_DEVICE=auto
NIMBUS_WATERMASK_DEVICE=auto
NIMBUS_INTEGRATED_MASK_WATER_BACKEND=omniwatermask
NIMBUS_INTEGRATED_MASK_FAIL_ON_ERROR=true
NIMBUS_CLOUDMASK_BATCH_SIZE=1
# Used for CPU/CUDA. On Apple Silicon, Nimbus keeps OmniWater in an internal safe
# MPS profile by default (single-batch, no model optimisation) and uses
# NIMBUS_MASK_SCENE_MAX_WORKERS for scene-level parallelism instead.
NIMBUS_WATERMASK_BATCH_SIZE=1
NIMBUS_CLOUDMASK_TILE_WORKERS=1
NIMBUS_WATERMASK_TILE_WORKERS=1
# Optional explicit cloud-mask tile size. Leave empty to keep Nimbus on the
# audited runtime default of 512 px for cloud masking.
NIMBUS_CLOUDMASK_TILE_SIZE=
# OmniCloudMask model window. Keep the model window tied to the audited 512 px
# mask tile unless a larger value is explicitly requested for debugging.
NIMBUS_CLOUDMASK_MODEL_TILE_SIZE=mask
# Water mask tile size. Use 512 px to match the audited runtime default and
# keep mask patches aligned with Zarr chunks.
NIMBUS_WATERMASK_TILE_SIZE=512
# OmniWater model export block. Use the same 512 px mask tile by default so the
# model output stays aligned with the Zarr chunks and avoids 4096 px seams.
NIMBUS_WATERMASK_MODEL_TILE_SIZE=mask
# Internal OmniWater inference patch. This does not change output/Zarr
# resolution; 512/128 matches the precise multi-tile mask behavior.
NIMBUS_WATERMASK_INFERENCE_PATCH_SIZE=512
NIMBUS_WATERMASK_INFERENCE_OVERLAP_SIZE=128
NIMBUS_WATERMASK_MODEL_PROGRESS_SECONDS=5
# Optional max scene-level parallelism when integrated masking runs from the
# fetch pipeline. Leave empty to use the backend/device heuristic.
NIMBUS_MASK_SCENE_MAX_WORKERS=
# Writable caches used by OmniWaterMask/OSMnx and model runtimes. Keep these on
# the shared /data volume so Podman containers do not try to write under /app.
NIMBUS_WATERMASK_OSMNX_CACHE_DIR=/data/downloads/mask-cache/osmnx
NIMBUS_WATERMASK_OSMNX_USE_CACHE=true
# Keep OmniWater on the full model path used by the multi-tile pipeline:
# neural model + NDWI + OSM priors. Set the max span to a positive meter value
# only when you explicitly want to disable OSM on very large scenes.
NIMBUS_WATERMASK_USE_OSM_WATER=false
NIMBUS_WATERMASK_USE_OSM_BUILDING=false
NIMBUS_WATERMASK_USE_OSM_ROADS=false
NIMBUS_WATERMASK_OSM_MAX_SCENE_SPAN_METERS=50000
NIMBUS_WATERMASK_MODEL_DIR=/data/downloads/mask-cache/omniwater-models
NIMBUS_MASK_XDG_CACHE_HOME=/data/downloads/mask-cache/xdg
NIMBUS_MASK_HF_HOME=/data/downloads/mask-cache/huggingface
NIMBUS_MASK_TORCH_HOME=/data/downloads/mask-cache/torch
NIMBUS_MASK_MPLCONFIGDIR=/data/downloads/mask-cache/matplotlib
# Keep this enabled on Apple Silicon unless you are explicitly benchmarking more
# aggressive OmniWater MPS settings.
NIMBUS_WATERMASK_MPS_SAFE_MODE=1
# Keep disabled for strict model tests: OmniWater MPS failures should fail with
# the real model error instead of switching to the heuristic fallback.
NIMBUS_WATERMASK_MPS_FAIL_OPEN=0
# Set to 1 to fail fast when a requested accelerator (cuda/mps) is unavailable.
NIMBUS_REQUIRE_ACCELERATOR=0
