# -----------------------------------------------------------------------------
# Local UI + OCI remote runtime
# Copy this file to .env.oci.local-ui on your laptop.
# -----------------------------------------------------------------------------
NIMBUS_SERVICE_URL=http://127.0.0.1:18000
NIMBUS_API_KEY=
NIMBUS_UI_PORT=18501
NIMBUS_UI_DATA_DIR=./data/downloads

# Remote SSH target:
NIMBUS_OCI_REMOTE_HOST=10.10.255.204
NIMBUS_OCI_REMOTE_USER=opc
NIMBUS_OCI_REMOTE_PORT=22
NIMBUS_OCI_SSH_KEY_FILE='/Users/mehdidinari/Desktop/backend nimbus/ssh-key-2026-04-23.key'

# Optional Bastion hop settings:
NIMBUS_OCI_SSH_PROXY_JUMP=
NIMBUS_OCI_SSH_PROXY_COMMAND='ssh -i "/Users/mehdidinari/Desktop/backend nimbus/ssh-key-2026-04-23.key" -W %h:%p -p 22 ocid1.bastionsession.oc1.uk-london-1.amaaaaaaie4v76ya65uyqjtz3mxp7xezjlsrihveqfp7tgwri5rp2tto53za@host.bastion.uk-london-1.oci.oraclecloud.com'

# Remote Nimbus service ports:
NIMBUS_OCI_REMOTE_API_PORT=28000
NIMBUS_OCI_REMOTE_ZARR_PORT=8010
NIMBUS_OCI_REMOTE_MASK_PORT=8020

# Local forwarded ports:
NIMBUS_OCI_LOCAL_API_PORT=18000
NIMBUS_OCI_LOCAL_ZARR_PORT=18010
NIMBUS_OCI_LOCAL_MASK_PORT=18020
NIMBUS_OCI_TUNNEL_ZARR=0
NIMBUS_OCI_TUNNEL_MASK=0
