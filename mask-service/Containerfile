ARG PYTHON_BASE=python:3.11.11-slim-bookworm
FROM ${PYTHON_BASE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/appuser \
    PYTHONPATH=/app/src \
    XDG_CACHE_HOME=/data/downloads/mask-cache/xdg \
    HF_HOME=/data/downloads/mask-cache/huggingface \
    TORCH_HOME=/data/downloads/mask-cache/torch \
    MPLCONFIGDIR=/data/downloads/mask-cache/matplotlib \
    NIMBUS_WATERMASK_OSMNX_CACHE_DIR=/data/downloads/mask-cache/osmnx \
    NIMBUS_WATERMASK_OSMNX_USE_CACHE=true \
    NIMBUS_WATERMASK_MODEL_DIR=/data/downloads/mask-cache/omniwater-models \
    NIMBUS_WATERMASK_BATCH_SIZE=1 \
    NIMBUS_WATERMASK_TILE_SIZE=512 \
    NIMBUS_WATERMASK_MODEL_TILE_SIZE=4096 \
    NIMBUS_WATERMASK_INFERENCE_PATCH_SIZE=128 \
    NIMBUS_WATERMASK_INFERENCE_OVERLAP_SIZE=32 \
    NIMBUS_WATERMASK_MODEL_PROGRESS_SECONDS=5 \
    NIMBUS_WATERMASK_USE_OSM_WATER=false \
    NIMBUS_WATERMASK_USE_OSM_BUILDING=false \
    NIMBUS_WATERMASK_USE_OSM_ROADS=false \
    NIMBUS_WATERMASK_OSM_MAX_SCENE_SPAN_METERS=50000

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libexpat1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxcb1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --create-home --uid 10001 --shell /usr/sbin/nologin appuser

COPY requirements/mask-service.txt /app/requirements/mask-service.txt
COPY requirements/runtime-common.txt /app/requirements/runtime-common.txt
RUN python -m pip install -r /app/requirements/mask-service.txt
ENV NIMBUS_WATERMASK_INFERENCE_PATCH_SIZE=512 \
    NIMBUS_WATERMASK_INFERENCE_OVERLAP_SIZE=128 \
    NIMBUS_WATERMASK_MODEL_TILE_SIZE=4096 \
    NIMBUS_WATERMASK_USE_OSM_WATER=false \
    NIMBUS_WATERMASK_USE_OSM_BUILDING=false \
    NIMBUS_WATERMASK_USE_OSM_ROADS=false \
    NIMBUS_WATERMASK_OSM_MAX_SCENE_SPAN_METERS=50000
COPY --chown=appuser:appuser src/nimbuschain_mask_service /app/src/nimbuschain_mask_service
COPY --chown=appuser:appuser src/nimbuschain_shared /app/src/nimbuschain_shared

USER appuser

EXPOSE 8020

CMD ["uvicorn", "nimbuschain_mask_service.main:app", "--host", "0.0.0.0", "--port", "8020"]
