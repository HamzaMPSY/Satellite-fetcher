FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    HOME=/home/appuser

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY pyproject.toml README.md /app/
COPY src /app/src
COPY data/Landsat-tiles /app/data/Landsat-tiles
COPY data/Sentinel-2-tiles /app/data/Sentinel-2-tiles

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir ".[ui]"

USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "src/nimbuschain_fetch_ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
