FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src \
    HOME=/home/appuser

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser

COPY requirements/ui.txt /app/requirements/ui.txt
COPY requirements/runtime-common.txt /app/requirements/runtime-common.txt
COPY src/nimbuschain_fetch /app/src/nimbuschain_fetch
COPY src/nimbuschain_fetch_ui /app/src/nimbuschain_fetch_ui
COPY src/nimbuschain_shared /app/src/nimbuschain_shared
COPY data/Landsat-tiles /app/data/Landsat-tiles
COPY data/Sentinel-2-tiles /app/data/Sentinel-2-tiles

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r /app/requirements/ui.txt

USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "src/nimbuschain_fetch_ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
