# -----------------------------------------------------------------------------
# Remote OCI GPU VM runtime
# Copy this file to .env.oci.remote on the VM.
# -----------------------------------------------------------------------------
NIMBUS_DB_BACKEND=sqlite
NIMBUS_DB_PATH=./data/nimbus-oci.db
NIMBUS_DATA_DIR=./data/downloads
NIMBUS_LOG_LEVEL=INFO
NIMBUS_LOG_JSON=false
NIMBUS_API_KEY=
NIMBUS_MASK_SERVICE_URL=http://127.0.0.1:8020

# OCI auth inside the GPU VM:
NIMBUS_OCI_AUTH=instance_principal
NIMBUS_OCI_NAMESPACE=
NIMBUS_OCI_COMPARTMENT_ID=
NIMBUS_OCI_REGION=

# Copernicus account pool for higher aggregate throughput in OCI mode:
NIMBUS_COPERNICUS_ACCOUNT_POOL_FILE=./docs/copernicus_account_pool.example.json
NIMBUS_COPERNICUS_ACCOUNT_POOL_CONCURRENCY=4

# GPU runtime:
NIMBUS_CLOUDMASK_DEVICE=cuda
NIMBUS_WATERMASK_DEVICE=cuda
NIMBUS_REQUIRE_ACCELERATOR=1
NIMBUS_CLOUDMASK_BATCH_SIZE=1
NIMBUS_WATERMASK_BATCH_SIZE=1
NIMBUS_CLOUDMASK_TILE_WORKERS=1
NIMBUS_WATERMASK_TILE_WORKERS=1
NIMBUS_COPERNICUS_USERNAME=hamza.el.makrini@oracle.com
NIMBUS_COPERNICUS_PASSWORD=-T/DYG69_333x_T
NIMBUS_USGS_USERNAME=saifvelly
NIMBUS_USGS_TOKEN=KYSO1QqhJJNtqPHU9tD!PLLu2deZShbOjg8CGqCxUuN@4_8mTBDkQQJ_SVqdH0FS
