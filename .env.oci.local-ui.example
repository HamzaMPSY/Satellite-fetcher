# -----------------------------------------------------------------------------
# Local UI + OCI remote runtime
# Copy this file to .env.oci.local-ui on your laptop.
# -----------------------------------------------------------------------------
NIMBUS_SERVICE_URL=http://127.0.0.1:18000
NIMBUS_API_KEY=
NIMBUS_UI_PORT=8501
NIMBUS_UI_DATA_DIR=./data/downloads

# Remote SSH target:
NIMBUS_OCI_REMOTE_HOST=
NIMBUS_OCI_REMOTE_USER=opc
NIMBUS_OCI_REMOTE_PORT=22
NIMBUS_OCI_SSH_KEY_FILE=~/.ssh/oci_gpu.key

# Optional Bastion hop settings:
NIMBUS_OCI_SSH_PROXY_JUMP=
NIMBUS_OCI_SSH_PROXY_COMMAND=

# Local forwarded ports:
NIMBUS_OCI_LOCAL_API_PORT=18000
NIMBUS_OCI_LOCAL_ZARR_PORT=18010
NIMBUS_OCI_LOCAL_MASK_PORT=18020
NIMBUS_OCI_TUNNEL_ZARR=0
NIMBUS_OCI_TUNNEL_MASK=0
