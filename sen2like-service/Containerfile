ARG SEN2LIKE_BASE=python:3.11.11-slim-bookworm
FROM ${SEN2LIKE_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/appuser \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/src:/app/sen2like \
    NIMBUS_SEN2LIKE_VENDOR_DIR=/app/sen2like \
    NIMBUS_SEN2LIKE_WORK_DIR=/data/downloads/sen2like \
    LANDSAT_UPSAMPLING_BASE=/app/sen2like \
    GDAL_CONFIG=/usr/bin/gdal-config \
    CPLUS_INCLUDE_PATH=/usr/include/gdal \
    C_INCLUDE_PATH=/usr/include/gdal

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      default-jre-headless \
      gdal-bin \
      libexpat1 \
      libgdal-dev \
      libgeos-dev \
      libproj-dev \
      libspatialindex-dev \
      pkg-config \
      proj-bin && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/venv && \
    useradd --system --create-home --uid 10001 --shell /usr/sbin/nologin appuser

COPY sen2like-service/vendor/Satellite-fetcher-feature-sen2like_reimplementation/requirements.txt /app/requirements/sen2like-upstream.txt
RUN python -m pip install --upgrade pip "setuptools<81" wheel && \
    grep -viE '^(GDAL|podman-compose|opencv-python-headless|pyrasterframes|zarr)==' \
      /app/requirements/sen2like-upstream.txt > /app/requirements/sen2like-container.txt && \
    printf '%s\n' 'opencv-python-headless==4.10.0.84' >> /app/requirements/sen2like-container.txt && \
    printf '%s\n' 'zarr==3.0.10' >> /app/requirements/sen2like-container.txt && \
    python -m pip install -r /app/requirements/sen2like-container.txt

COPY --chown=appuser:appuser src/nimbuschain_sen2like_service /app/src/nimbuschain_sen2like_service
COPY --chown=appuser:appuser src/nimbuschain_shared /app/src/nimbuschain_shared
COPY --chown=appuser:appuser sen2like-service/vendor/Satellite-fetcher-feature-sen2like_reimplementation /app/sen2like

USER appuser

EXPOSE 8030

CMD ["uvicorn", "nimbuschain_sen2like_service.main:app", "--host", "0.0.0.0", "--port", "8030"]
